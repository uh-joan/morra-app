# morra.joans.cat — static site block for the SHARED Caddy on the Hetzner box
# (the one already serving buzz). Append this to that box's Caddyfile
# (buzz-relay-ops → buzz/deploy/compose/Caddyfile), then reload Caddy.
#
# Caddy auto-issues the Let's Encrypt cert on first request. The app's full
# Content-Security-Policy ships as a <meta> in index.html; the header block
# below adds the header-only hardening a meta CSP can't express (same set as
# apps/play/public/_headers, which Caddy does not read).
morra.joans.cat {
  encode zstd gzip
  root * /srv/morra
  file_server

  # Telemetry: the app batches NDJSON events to /log (telemetry.ts). The
  # collector container (deploy/collector/) joins the buzz network and
  # appends to /srv/morra-logs. If it's down, this 502s and the app drops
  # events silently by design — gameplay never depends on it.
  reverse_proxy /log morra-collector:9310
  # La Classificació global: the one arcade table for every vessel — GET the
  # top-10, POST a won match (server-validated). Same collector, same
  # doctrine: down → 502 → the app falls back to its local board.
  reverse_proxy /classificacio morra-collector:9310

  header {
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
    Content-Security-Policy "frame-ancestors 'none'"
  }

  # Without Cache-Control browsers fall back to heuristic freshness off
  # last-modified — and every deploy rsyncs fresh mtimes, churning Caddy's
  # mtime-derived etags too. Net effect in the field: phones re-downloaded
  # the 41 MB vosk model almost every visit.
  # index.html must REVALIDATE on every open (field finding 2026-08-30):
  # with no Cache-Control the iOS home-screen app relaunches from heuristic
  # cache and pins a stale bundle — standalone sessions still ran an old
  # build minutes after browser tabs had the new one, so no shipped fix
  # could reach them. no-cache = always revalidate; the etag makes the
  # common case a cheap 304.
  @html path / /index.html
  header @html Cache-Control "no-cache"
  # The model zip carries its version in the filename → immutable is safe.
  @model path /assets/vosk-model/*
  header @model Cache-Control "public, max-age=31536000, immutable"
  # Vite bundles are content-hashed (index-XXXX.js) → immutable is safe.
  # (Vendor + rival-voice files live in subdirs, so this glob skips them.)
  @hashed path /assets/*.js /assets/*.css
  header @hashed Cache-Control "public, max-age=31536000, immutable"
  # Vendored MediaPipe (~11 MB) and the rival clips are name-stable — they
  # CAN change on a dep bump without renaming, so a week, not immutable.
  @vendored path /assets/vendor/* /assets/rival-voice/*
  header @vendored Cache-Control "public, max-age=604800"
}
